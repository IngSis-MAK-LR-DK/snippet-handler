# Copiar a .env y completar. docker compose lo lee automaticamente.

# Auth0 (con la barra final en el issuer)
AUTH0_ISSUER_URI=https://<tenant>.auth0.com/
AUTH0_AUDIENCE=<api-identifier>

# Postgres del handler (puerto 5433 en el host; Permisos usa 5434)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/snippets
SPRING_DATASOURCE_USERNAME=snippets
SPRING_DATASOURCE_PASSWORD=snippets

# Servicios
PERMISSION_SERVICE_URL=http://localhost:8081
ASSET_SERVICE_URL=http://localhost:8082
ASSET_CONTAINER=snippets
PRINTSCRIPT_SERVICE_URL=http://localhost:8083

# UI
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Auth0 Management API (busqueda de usuarios para compartir). Client M2M con scope read:users.
AUTH0_MANAGEMENT_DOMAIN=
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=

# Token propio del handler para llamar a los adaptadores sin usuario (tests que corren al editar
# un snippet, revalidacion). Client M2M autorizado para la API de AUTH0_AUDIENCE. Sin esto, esas
# llamadas salen sin token y el adaptador responde 401.
AUTH0_SERVICE_CLIENT_ID=
AUTH0_SERVICE_CLIENT_SECRET=
