# Copiar a .env y completar. Lo leen docker compose y ./gradlew bootRun (spring.config.import).

# --- Auth0 (ver README de la catedra: austral-ingsis/auth0-integration) ---------------------------
# AUTH0_DOMAIN: dominio del tenant, SIN https:// (ej. dev-xxxx.us.auth0.com)
# AUTH0_AUDIENCE: "Identifier" de la API snippet-searcher (el "aud" del token). Es UNA SOLA para
#   toda la plataforma: todos los servicios validan la misma.
AUTH0_DOMAIN=TU-TENANT.us.auth0.com
AUTH0_AUDIENCE=https://snippet-searcher

# Token de servicio: application M2M "snippet-handler-service", autorizada SOLO para la API
# snippet-searcher. Se usa en el trabajo de fondo sin usuario (tests al editar un snippet,
# revalidacion). Sin esto, esas llamadas al adaptador salen sin token y responden 401.
AUTH0_SERVICE_CLIENT_ID=
AUTH0_SERVICE_CLIENT_SECRET=

# Busqueda de usuarios para compartir (GET /users): application M2M "snippet-handler-management",
# autorizada SOLO para la Auth0 Management API con el permiso read:users. Sin esto, GET /users da 502.
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=

# --- Postgres del handler (puerto 5433 en el host; Permisos usa 5434) -----------------------------
# La URL es para bootRun; en Docker el handler usa db:5432 (ver docker-compose.yml).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/snippets
SPRING_DATASOURCE_USERNAME=snippets
SPRING_DATASOURCE_PASSWORD=snippets

# --- Otros servicios, vistos desde tu maquina (para bootRun) --------------------------------------
# En Docker no se usan: docker-compose.yml apunta a asset-service y a host.docker.internal.
PERMISSION_SERVICE_URL=http://localhost:8081
ASSET_SERVICE_URL=http://localhost:8082
PRINTSCRIPT_SERVICE_URL=http://localhost:8083
ASSET_CONTAINER=snippets

# --- UI -------------------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- GitHub Packages -------------------------------------------------------------------------------
# Para bajar el plugin de ci-kit al construir la imagen (las mismas gpr.user y gpr.key de
# ~/.gradle/gradle.properties). NO commitear el .env.
GPR_USER=
GPR_KEY=
